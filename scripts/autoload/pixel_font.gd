func _ready() -> void:
	font = _build_font()
	ThemeDB.fallback_font = font
	ThemeDB.fallback_font_size = BASE


func _build_font() -> FontFile:
	var f := FontFile.new()
	f.fixed_size = BASE
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	f.hinting = TextServer.HINTING_NONE
	f.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
	f.generate_mipmaps = false
	f.allow_system_fallback = false
	var keys: Array = GLYPHS.keys()
	var cols := 16
	var rows := int(ceil(keys.size() / float(cols)))
	var img := Image.create(cols * CELL_W, rows * CELL_H, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	var sz := Vector2i(BASE, 0)
	for i in keys.size():
		var ch: String = keys[i]
		var gx := (i % cols) * CELL_W
		var gy := (i / cols) * CELL_H
		var rows_data: Array = GLYPHS[ch]
		for y in rows_data.size():
			var line: String = rows_data[y]
			for x in line.length():
				if line[x] == "#":
					img.set_pixel(gx + x, gy + y, Color.WHITE)
		var codes: Array = [ch.unicode_at(0)]
		var lower := ch.to_lower()
		if lower != ch:
			codes.append(lower.unicode_at(0))
		for c in codes:
			f.set_glyph_advance(0, BASE, c, Vector2(CELL_W, 0))
			f.set_glyph_offset(0, sz, c, Vector2(0, -7))
			f.set_glyph_size(0, sz, c, Vector2(5, 7))
			f.set_glyph_uv_rect(0, sz, c, Rect2(gx, gy, 5, 7))
			f.set_glyph_texture_idx(0, sz, c, 0)
	f.set_texture_image(0, sz, 0, img)
	f.set_cache_ascent(0, BASE, 7)
	f.set_cache_descent(0, BASE, 2)
	return f


## Width in pixels of `text` drawn at integer `scale`.
func text_width(text: String, scale: int = 1) -> int:
	if text.is_empty():
		return 0
	return (text.length() * CELL_W - 1) * scale


## Draw text with its top-left at `pos`. align: 0 left, 1 center, 2 right.
func draw_text(ci: CanvasItem, pos: Vector2, text: String, color: Color = Color.WHITE,
		scale: int = 1, align: int = 0, shadow: bool = true, shadow_color: Color = Color(0.05, 0.03, 0.08, 0.9)) -> void:
	var w := text_width(text, scale)
	var p := pos
	if align == 1:
		p.x -= w / 2
	elif align == 2:
		p.x -= w
	p = p.floor()
	var baseline := p + Vector2(0, 7 * scale)
	if shadow:
		ci.draw_string(font, baseline + Vector2(scale, scale), text, HORIZONTAL_ALIGNMENT_LEFT, -1, BASE * scale, shadow_color)
	ci.draw_string(font, baseline, text, HORIZONTAL_ALIGNMENT_LEFT, -1, BASE * scale, color)


## Draw text with a full 1px outline (used for in-world tags over busy art).
func draw_outlined(ci: CanvasItem, pos: Vector2, text: String, color: Color, outline: Color = Color(0.05, 0.03, 0.08), scale: int = 1, align: int = 1) -> void:
	for o in [Vector2(-1, 0), Vector2(1, 0), Vector2(0, -1), Vector2(0, 1)]:
		draw_text(ci, pos + o, text, outline, scale, align, false)
	draw_text(ci, pos, text, color, scale, align, false)


## Word-wrap text into lines that fit `max_w` pixels.
func wrap(text: String, max_w: int, scale: int = 1) -> PackedStringArray:
	var out := PackedStringArray()
	for para in text.split("\n"):
		var line := ""
		for word in para.split(" "):
			var trial := word if line.is_empty() else line + " " + word
			if text_width(trial, scale) > max_w and not line.is_empty():
				out.append(line)
				line = word
			else:
				line = trial
		out.append(line)
	return out
